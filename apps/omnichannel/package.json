{
	"name": "@rocket.chat/omnichannel",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "nodemon",
		"build": "rm -rf dist && tsc -p tsconfig.json",
		"lint": "eslint --ext .ts .",
		"lint:fix": "eslint --ext .ts . --fix",
		"test:unit": "jest --testPathPattern ./src/**/*.spec.ts",
		"test:integration": "jest --testPathPattern ./tests/integration/**/*.spec.ts --forceExit",
		"test:arch": "jest --config=./jest-arch.config.ts"
	},
	"dependencies": {
		"@rocket.chat/fuel": "workspace:^",
		"@rocket.chat/random": "workspace:^",
		"reflect-metadata": "^0.2.2"
	},
	"volta": {
		"extends": "../../package.json"
	},
	"devDependencies": {
		"@rocket.chat/eslint-config": "workspace:^",
		"@swc/jest": "^0.2.36",
		"eslint": "~8.45.0",
		"jest": "^29.7.0",
		"nodemon": "^3.1.7",
		"ts-jest": "^29.2.5",
		"ts-node": "^10.9.2",
		"typescript": "5.6.3"
	}
}
